# development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL (docker compose up -d db で起動する場合の値)
DATABASE_URL=postgres://tadori:tadori@localhost:5432/tadori

# Better Auth: `openssl rand -base64 32` で生成する
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
BETTER_AUTH_URL=http://localhost:4000

# カンマ区切り。Web クライアント用 (Expo ネイティブアプリは CORS の対象外)
CORS_ORIGIN=http://localhost:8081

# Expo アプリの deep link scheme (Better Auth の trustedOrigins に入る)
APP_SCHEME=tadori

# --- ログイン方式 ---
# メール + パスワード。未指定なら production では無効、それ以外では有効
AUTH_EMAIL_PASSWORD_ENABLED=
# Google: カンマ区切りで複数可 (先頭が Web 用。続けて iOS / Android の client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: CLIENT_ID は Service ID、SECRET は .p8 から生成した JWT、BUNDLE は iOS の bundle ID
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=app.tadori.mobile

# 任意: Expo Push の Enhanced Security を有効にしている場合のみ
EXPO_ACCESS_TOKEN=

# debug | info | warn | error | silent (未指定なら NODE_ENV から決定)
LOG_LEVEL=
