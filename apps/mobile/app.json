{
  "expo": {
    "name": "Readtree",
    "slug": "readtree",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "readtree",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.readtree.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.readtree.mobile"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Readtree — 誰かが作った学びの道を、辿る。"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "本に登録する画像を選択します。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
