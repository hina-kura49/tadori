# Unset = persisted local Mock API
# Set = real API (apps/api). On a real device use the Mac's LAN IP, not localhost.
# Prefer passing it to the dev server process instead of writing it to .env, so
# mock-based e2e tests keep working:
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:4000 npx expo start
# EXPO_PUBLIC_API_URL=http://192.168.0.10:4000

# "true" once the API has image upload endpoints. Until then images stay on the device.
# EXPO_PUBLIC_IMAGE_UPLOAD=false
